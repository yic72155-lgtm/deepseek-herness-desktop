{
  "name": "deepseek-harness-desktop",
  "version": "0.1.0",
  "description": "DeepSeek Harness Windows desktop client",
  "main": "dist/main/index.js",
  "private": true,
  "author": "DeepSeek Harness Desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/yic72155-lgtm/deepseek-herness-desktop.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win nsis portable",
    "release": "npm run build && electron-builder --win nsis portable --publish always",
    "dist": "npm run pack"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/cordis-plugin-group": "1.0.1",
    "@deepseek-ai/dsh-scope": "0.1.0-rc.6",
    "@deepseek-ai/dsh-timeout": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sandbox": "0.1.0-rc.6",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2"
  }
}
